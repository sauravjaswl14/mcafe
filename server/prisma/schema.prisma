generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CUSTOMER
}

enum BeanForm {
  WHOLE_BEANS
  GROUND
  PACKAGED
}

enum Roast {
  LIGHT
  MEDIUM
  DARK
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  ROOM_SERVICE
  ONLINE
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  ONLINE
  ROOM_CHARGE
}

enum PurchaseStatus {
  ORDERED
  RECEIVED
  CANCELLED
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  CLEANING
  MAINTENANCE
}

enum BookingStatus {
  RESERVED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

// ───────────── Auth ─────────────
model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())
  orders       Order[]
}

// ───────────── Catalog ─────────────
model Product {
  id          Int              @id @default(autoincrement())
  slug        String           @unique
  name        String
  origin      String
  roast       Roast
  flavors     String[]
  description String
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  variants    ProductVariant[]
}

model ProductVariant {
  id            Int            @id @default(autoincrement())
  productId     Int
  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  form          BeanForm
  sizeGrams     Int
  price         Int
  stock         Int            @default(0)
  active        Boolean        @default(true)
  orderItems    OrderItem[]
  purchaseItems PurchaseItem[]

  @@unique([productId, form, sizeGrams])
}

model MenuCategory {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  sortOrder Int        @default(0)
  items     MenuItem[]
}

model MenuItem {
  id          Int          @id @default(autoincrement())
  categoryId  Int
  category    MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  description String       @default("")
  price       Int
  available   Boolean      @default(true)
  orderItems  OrderItem[]

  @@unique([categoryId, name])
}

// ───────────── Orders & sales ─────────────
model Order {
  id            Int         @id @default(autoincrement())
  type          OrderType   @default(ONLINE)
  status        OrderStatus @default(PENDING)
  customerName  String
  customerPhone String?
  notes         String?
  total         Int
  userId        Int?
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  bookingId     Int?
  booking       Booking?    @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  sale          Sale?
  createdAt     DateTime    @default(now())

  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id         Int             @id @default(autoincrement())
  orderId    Int
  order      Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId  Int?
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  menuItemId Int?
  menuItem   MenuItem?       @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  name       String // snapshot at time of order
  unitPrice  Int
  quantity   Int
}

model Sale {
  id        Int           @id @default(autoincrement())
  orderId   Int           @unique
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount    Int
  method    PaymentMethod @default(CASH)
  paidAt    DateTime      @default(now())

  @@index([paidAt])
}

// ───────────── Purchasing ─────────────
model Supplier {
  id        Int             @id @default(autoincrement())
  name      String
  phone     String?
  email     String?
  address   String?
  purchases PurchaseOrder[]
}

model PurchaseOrder {
  id         Int            @id @default(autoincrement())
  supplierId Int
  supplier   Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  status     PurchaseStatus @default(ORDERED)
  total      Int
  notes      String?
  createdAt  DateTime       @default(now())
  receivedAt DateTime?
  items      PurchaseItem[]
}

model PurchaseItem {
  id         Int            @id @default(autoincrement())
  purchaseId Int
  purchase   PurchaseOrder  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  variantId  Int
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity   Int
  unitCost   Int
}

// ───────────── Hotel management (HMS) ─────────────
model Room {
  id       Int        @id @default(autoincrement())
  number   String     @unique
  type     String
  capacity Int        @default(2)
  rate     Int
  status   RoomStatus @default(AVAILABLE)
  bookings Booking[]
}

model Guest {
  id       Int       @id @default(autoincrement())
  name     String
  phone    String?
  email    String?
  idNumber String?
  bookings Booking[]
}

model Booking {
  id          Int           @id @default(autoincrement())
  roomId      Int
  room        Room          @relation(fields: [roomId], references: [id], onDelete: Restrict)
  guestId     Int
  guest       Guest         @relation(fields: [guestId], references: [id], onDelete: Restrict)
  checkIn     DateTime
  checkOut    DateTime
  status      BookingStatus @default(RESERVED)
  nightlyRate Int
  total       Int           @default(0)
  createdAt   DateTime      @default(now())
  orders      Order[]

  @@index([roomId, checkIn, checkOut])
}
